{
  "name": "flash-cards",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "npm-run-all --parallel css:watch build:watch dev",
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "fix": "npm run lint:fix && npm run format",
    "css:types": "tcm src --camelCase",
    "css:watch": "tcm src --camelCase --watch",
    "ci": "npm run css:types && npm run check && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raylyanway/flash-cards.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.4",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.4.0"
  },
  "bugs": {
    "url": "https://github.com/raylyanway/flash-cards/issues"
  },
  "homepage": "https://github.com/raylyanway/flash-cards#readme",
  "dependencies": {
    "@mui/material": "^9.4.0",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  }
}
